# ====================================================================
# LOCALROOTS SERVER ENVIRONMENT CONFIGURATION
# ====================================================================

# Port and Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Secret for Seller and Admin session tokens
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# Supabase PostgreSQL & Auth Credentials
# (If left empty, server automatically falls back to verified in-memory demo data)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Razorpay Sandbox / Production Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_sandbox_key_id
RAZORPAY_KEY_SECRET=your_sandbox_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Marketplace Direct Settlement Rail (e.g. Razorpay Route / Cashfree Split)
MARKETPLACE_SETTLEMENT_ENABLED=true
